{
  "build": {
    "context": "..",
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/var/dev-state/claude",
    "GIT_CONFIG_GLOBAL": "/var/dev-state/gitconfig",
    "HERMES_HOME": "/var/dev-state/hermes",
    "MISE_DATA_DIR": "/var/dev-state/mise",
    "MISE_ENV": "devcontainer",
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces",
    "OPENCODE_CONFIG_DIR": "/var/dev-state/opencode"
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/devcontainer-community/devcontainer-features/hermes-agent.nousresearch.com:1": {},
    "ghcr.io/devcontainers-extra/features/npm-package:1": {
      "package": "@opencode/cli"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {}
  },
  "mounts": [
    "source=dev-cli-state,target=/var/dev-state,type=volume"
  ],
  "name": "dev-cli",
  "postCreateCommand": "sudo chown vscode:vscode /var/dev-state && mise install",
  "remoteUser": "vscode"
}
