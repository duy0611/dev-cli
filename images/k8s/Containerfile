# dcx-k8s — kubectl, helm, k9s and the aws CLI, behind expiry shims.
#
# Plugins are inherited: dcx-base already staged them at /opt/claude-seed, and
# nothing here touches $CLAUDE_CONFIG_DIR, so there is nothing to re-bake.
#
#   docker build -f images/k8s/Containerfile -t localhost/dcx-k8s:latest .
FROM localhost/dcx-base:latest

ARG KUBECTL_VERSION=v1.31.4
ARG HELM_VERSION=v3.16.3
ARG K9S_VERSION=v0.32.7

# Every RUN below pipes (curl | tar, curl | gpg). Without pipefail the exit
# status is the last command's, so a failed download would be silently packaged
# as an empty archive rather than failing the build.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

# Real binaries go in real/; /usr/local/bin/<tool> is a symlink to the shim,
# which checks the credential's expiry sidecar before exec'ing the real one.
# The aws CLI is here for direct use only — cluster auth uses a minted
# ServiceAccount token, so kubectl needs no exec credential plugin.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) k8s_arch=arm64; aws_arch=aarch64 ;; \
      amd64) k8s_arch=amd64; aws_arch=x86_64  ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    \
    curl -fsSLo /usr/local/bin/real/kubectl \
      "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${k8s_arch}/kubectl"; \
    chmod 0755 /usr/local/bin/real/kubectl; \
    \
    curl -fsSL "https://get.helm.sh/helm-${HELM_VERSION}-linux-${k8s_arch}.tar.gz" \
      | tar -xz -C /tmp; \
    install -m 0755 "/tmp/linux-${k8s_arch}/helm" /usr/local/bin/real/helm; \
    rm -rf "/tmp/linux-${k8s_arch}"; \
    \
    curl -fsSL "https://github.com/derailed/k9s/releases/download/${K9S_VERSION}/k9s_Linux_${k8s_arch}.tar.gz" \
      | tar -xz -C /tmp k9s; \
    install -m 0755 /tmp/k9s /usr/local/bin/real/k9s; \
    rm -f /tmp/k9s; \
    \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}.zip" -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install --bin-dir /usr/local/bin/real --install-dir /usr/local/aws-cli; \
    rm -rf /tmp/awscliv2.zip /tmp/aws; \
    \
    for t in kubectl helm k9s aws; do ln -sf /usr/local/bin/dcx-shim "/usr/local/bin/$t"; done; \
    \
    /usr/local/bin/real/kubectl version --client=true --output=yaml >/dev/null; \
    /usr/local/bin/real/helm version --short >/dev/null; \
    /usr/local/bin/real/aws --version >/dev/null

USER node
