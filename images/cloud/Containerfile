# dcx-cloud — the Google Cloud SDK and the aws CLI, behind expiry shims.
#
# Both providers live here, and neither lives in dcx-k8s: cluster auth is a
# minted ServiceAccount token, so kubectl needs no provider CLI at all, and an
# AWS session in a profile named for Kubernetes would be an unrelated grant
# nothing in that image reads.
#
# Parameterised on BASE so it builds both cloud images without duplicating the
# layer — dcx-full is exactly dcx-k8s plus this:
#
#   docker build -f images/cloud/Containerfile \
#     --build-arg BASE=localhost/dcx-base:latest -t localhost/dcx-cloud:latest .
#   docker build -f images/cloud/Containerfile \
#     --build-arg BASE=localhost/dcx-k8s:latest  -t localhost/dcx-full:latest .
#
# Plugins are inherited from dcx-base via /opt/claude-seed.
ARG BASE=localhost/dcx-base:latest
FROM ${BASE}

# Every RUN below pipes (curl | tar, curl | gpg). Without pipefail the exit
# status is the last command's, so a failed download would be silently packaged
# as an empty archive rather than failing the build.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

# The SDK reads its access token from CLOUDSDK_AUTH_ACCESS_TOKEN_FILE on every
# invocation, so a host-side refresh needs no restart. gsutil and bq get shims
# too: they share the same credential and the same expiry.
RUN set -eux; \
    curl -fsSL https://packages.cloud.google.com/apt/doc/apt-key.gpg \
      | gpg --dearmor -o /usr/share/keyrings/cloud.google.gpg; \
    echo "deb [signed-by=/usr/share/keyrings/cloud.google.gpg] https://packages.cloud.google.com/apt cloud-sdk main" \
      > /etc/apt/sources.list.d/google-cloud-sdk.list; \
    apt-get update; \
    apt-get install -y --no-install-recommends google-cloud-cli; \
    apt-get clean; rm -rf /var/lib/apt/lists/*; \
    \
    for t in gcloud gsutil bq; do \
      if [ -x "/usr/bin/$t" ]; then \
        ln -sf "/usr/bin/$t" "/usr/local/bin/real/$t"; \
        ln -sf /usr/local/bin/dcx-shim "/usr/local/bin/$t"; \
      fi; \
    done; \
    \
    /usr/local/bin/real/gcloud version >/dev/null

# The aws CLI reads AWS_SHARED_CREDENTIALS_FILE on every invocation, same
# property as the SDK above, so a host-side refresh needs no restart either.
RUN set -eux; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) aws_arch=aarch64 ;; \
      amd64) aws_arch=x86_64  ;; \
      *) echo "unsupported arch: $arch" >&2; exit 1 ;; \
    esac; \
    \
    curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-${aws_arch}.zip" -o /tmp/awscliv2.zip; \
    unzip -q /tmp/awscliv2.zip -d /tmp; \
    /tmp/aws/install --bin-dir /usr/local/bin/real --install-dir /usr/local/aws-cli; \
    rm -rf /tmp/awscliv2.zip /tmp/aws; \
    \
    ln -sf /usr/local/bin/dcx-shim /usr/local/bin/aws; \
    \
    /usr/local/bin/real/aws --version >/dev/null

USER node
