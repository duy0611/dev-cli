<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs `dccred watch`: one process for every instance, polling expiry sidecars
  and firing a Herdr notification when a credential goes stale.

  install.sh substitutes @BIN@ and @HOME@ and copies this to
  ~/Library/LaunchAgents/. PATH is set explicitly because a launchd agent does
  not inherit a login shell's: dccred needs herdr, jq, and docker.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.dcx.dccred-watch</string>

  <key>ProgramArguments</key>
  <array>
    <string>@BIN@/dccred</string>
    <string>watch</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@BIN@:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key>
    <string>@HOME@</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <!-- Do not hammer a restart loop if dccred is broken. -->
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>@HOME@/Library/Logs/dccred-watch.log</string>
  <key>StandardErrorPath</key>
  <string>@HOME@/Library/Logs/dccred-watch.log</string>
</dict>
</plist>
