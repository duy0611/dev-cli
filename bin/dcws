#!/usr/bin/env bash
# dcws - bootstrap a Herdr workspace for a devcontainer or a profile sandbox.
#
# Creates a workspace with two panes:
#   left   shell:<label>    -> dcx        (shell inside the container)
#   right  claude:<label>   -> dcclaude   (Claude Code inside the container)
#
# In project mode the label is the repo name, as before. In profile mode it is
# the instance name, so several sandboxes on one project stay distinguishable.
#
# After a server restart or reboot Herdr restores layout but not processes;
# `dcws -r` refills the panes. After a plain detach/reattach nothing is needed.
set -euo pipefail

die() { printf 'dcws: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'EOF'
dcws - bootstrap a Herdr workspace for a devcontainer or a profile sandbox.

Usage:
  dcws [-n NAME] [-r] [--no-claude] [-p PROFILE [--as INSTANCE]] [FOLDER]
  dcws --worktree BRANCH [--base REF] [other options] [FOLDER]
  dcws --rm-worktree BRANCH [--force] [FOLDER]

Creates a Herdr workspace with two panes:
  left   shell:<label>    -> dcx        (shell inside the container)
  right  claude:<label>   -> dcclaude   (Claude Code inside the container)
If the workspace already exists it is focused instead of duplicated.

Options:
  -n, --name NAME    Workspace label. Default: instance name in profile mode,
                     else basename of FOLDER.
  -r, --restart      Reuse the existing workspace and relaunch panes that have
                     no foreground process. Panes still running are left alone.
      --no-claude    Shell pane only; skip the Claude pane.
  -p, --profile P    base | k8s | cloud | full. Profile mode: no .devcontainer
                     needed in FOLDER.
      --as INSTANCE  Instance name. Default: basename of FOLDER.
      --auth MODE    litellm (default) | oauth. Passed through on create.
      --gitconfig    Passed through to dcx.
      --sign         Passed through to dcx (--gpg is an alias).
      --worktree BRANCH
                     Create (or open) a git worktree for BRANCH via Herdr and
                     run the panes against the checkout instead of the repo.
                     Worktree instances mirror host paths into the container,
                     so the same checkout is usable from a host session too.
      --base REF     Branch from REF instead of HEAD. Only with --worktree.
      --rm-worktree BRANCH
                     Remove the instance for BRANCH's worktree, then the
                     checkout itself, in that order. The branch is kept.
      --force        Remove even when the checkout is dirty. Only with
                     --rm-worktree; passed through to Herdr's own gate.
  -h, --help         Show this help.

Arguments:
  FOLDER             Project folder. Default: $PWD. In project mode it must
                     hold a devcontainer config.

Examples:
  dcws                                      Bootstrap for the current repo
  dcws -p k8s --as sk8s-debug               Sandbox workspace with k8s creds
  dcws -r -p k8s --as sk8s-debug            Refill panes after a server restart
  dcws --worktree feat/thing                Workspace on a Herdr worktree
  dcws --worktree feat/thing --base main    ...branched from main, not HEAD
  dcws --rm-worktree feat/thing             Instance first, then the checkout

Notes:
  Detach/reattach keeps processes alive - nothing to rerun. A server restart or
  reboot restores layout but not processes; that is what -r is for.
  Related: dcx (shell/command), dcclaude (agent), dccred (credentials).
EOF
}

command -v jq >/dev/null || die "jq is required"
command -v dcx >/dev/null || die "dcx not found on PATH"

need_herdr() {
  herdr workspace list >/dev/null 2>&1 \
    || die "no Herdr server reachable - run 'herdr' first"
}

# `first(...)` rather than `| head -1`: head closes the pipe on the first line
# while jq is still writing the rest, and under `pipefail` that SIGPIPE becomes
# the script's own exit status (141, silently).
herdr_workspace_id() { # <label>
  herdr workspace list | jq -r --arg n "$1" \
    'first(.result.workspaces[] | select(.label == $n) | .workspace_id)'
}

# Instance names become volume names and a directory, so a branch like feat/foo
# cannot be one verbatim. Computed here rather than read back from Herdr's own
# directory slug: that rule is not part of its documented contract, and
# --rm-worktree has to derive the same name later without asking Herdr.
#
# printf without a newline matters - `tr -c` would translate a trailing newline
# into a dash and every instance name would end in one.
dcws_slugify() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '-'; }

# The checkout for a branch, straight from git. Herdr's worktree record is the
# faster source but its field names are not documented; git is authoritative.
# Works from anywhere in the repo or any of its worktrees - `git worktree list`
# reports the whole set whichever one you ask from.
#
# awk keeps the first match itself instead of a trailing `head -1`, so nothing
# downstream ever closes the pipe early - see herdr_workspace_id above.
wt_path_for_branch() { # <repo-or-worktree> <branch>
  git -C "$1" worktree list --porcelain \
    | awk -v b="refs/heads/$2" \
      '/^worktree /{p=$2} /^branch /{if ($2==b && !seen) {print p; seen=1}}'
}

# The instance bound to a given workspace path, empty when none is. dcx --list
# prints `name profile workspace`, padded with %-24s %-7s; the workspace is
# everything from the third field on, so it is reassembled rather than read as
# $3 - a path with a space in it would otherwise match nothing.
#
# The list is buffered into a variable and fed to awk as a here-string rather
# than piped. `dcx --list` forks two jq per instance, so it is still printing
# long after awk has found its match; BSD awk (macOS) exits the moment it does,
# and the next printf in that loop takes SIGPIPE. With `pipefail` that killed
# `dcws --rm-worktree` with 141 before it removed anything, and the 2>/dev/null
# swallowed every trace of it. A here-string is a temp file - no pipe, no
# writer left to signal. Linux mawk drains stdin before exiting, which is why
# this never reproduced in a container.
instance_for_checkout() { # <abs-checkout-path>
  [ -n "$1" ] || return 0
  local list
  # A dcx that cannot list is the same answer as no match: fall back to the
  # create-time naming rule rather than aborting the teardown.
  list="$(dcx --list 2>/dev/null)" || return 0
  awk -v w="$1" '
    { ws = $3; for (i = 4; i <= NF; i++) ws = ws " " $i
      if (ws == w) { print $1; exit } }' <<<"$list"
}

name=""
restart=0
want_claude=1
folder=""
profile=""
instance=""
branch=""
base=""
rm_branch=""
force=0
passthru=()

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--name)    [ $# -ge 2 ] || die "-n needs a value"; name="$2"; shift 2 ;;
    -r|--restart) restart=1; shift ;;
    --no-claude)  want_claude=0; shift ;;
    -p|--profile) [ $# -ge 2 ] || die "-p needs a profile"; profile="$2"; shift 2 ;;
    --as)         [ $# -ge 2 ] || die "--as needs a name"; instance="$2"; shift 2 ;;
    --auth)       [ $# -ge 2 ] || die "--auth needs a mode"; passthru+=("$1" "$2"); shift 2 ;;
    --gitconfig|--sign|--gpg) passthru+=("$1"); shift ;;
    --worktree)    [ $# -ge 2 ] || die "--worktree needs a branch"; branch="$2"; shift 2 ;;
    --base)        [ $# -ge 2 ] || die "--base needs a ref"; base="$2"; shift 2 ;;
    --rm-worktree) [ $# -ge 2 ] || die "--rm-worktree needs a branch"; rm_branch="$2"; shift 2 ;;
    --force)       force=1; shift ;;
    -h|--help)    usage; exit 0 ;;
    -*)           usage >&2; die "unknown option: $1" ;;
    *)            folder="$1"; shift ;;
  esac
done

[ -n "$branch" ] && [ -n "$rm_branch" ] \
  && die "--worktree and --rm-worktree are mutually exclusive" || true
[ -n "$base" ] && [ -z "$branch" ] && die "--base only makes sense with --worktree" || true
[ "$force" -eq 1 ] && [ -z "$rm_branch" ] \
  && die "--force only makes sense with --rm-worktree" || true

[ -n "$folder" ] || folder="$PWD"
[ -d "$folder" ] || die "not a directory: $folder"
folder="$(cd "$folder" && pwd -P)"

# --- worktree teardown ---------------------------------------------------------
#
# Order matters. The container holds a bind mount on the checkout, and
# `git worktree remove` against a directory a running container is writing to
# leaves a half-removed worktree that neither side will clean up. So the
# instance dies first, then Herdr removes the checkout.
#
# The branch survives: that is `herdr worktree remove`'s documented behaviour,
# and inheriting it beats surprising anyone with a second policy here.
if [ -n "$rm_branch" ]; then
  need_herdr

  rm_checkout="$(wt_path_for_branch "$folder" "$rm_branch")"
  rm_slug="$(dcws_slugify "$(basename "$folder")-$rm_branch")"

  # Look the instance up by the checkout it is bound to, rather than
  # recomputing the name from $PWD. Re-deriving means the name only matches
  # when this runs from the same directory create did, and a miss removes
  # nothing while still reporting success - which is how orphaned containers
  # and volumes accumulate. The recorded workspace path is the reliable key.
  [ -n "$instance" ] || instance="$(instance_for_checkout "$rm_checkout")"
  # No match means the checkout is already gone, or was never containered.
  # Fall back to the create-time naming rule so the old behaviour still applies.
  [ -n "$instance" ] || instance="$rm_slug"

  # The Herdr label is a separate namespace from the instance name, so it is
  # derived separately. They coincide only when this same rule produced both;
  # an instance found by checkout path may be named anything (--as, or created
  # before the current rule), and feeding that name to Herdr silently matched
  # no workspace - the instance went away and the checkout stayed. Herdr's
  # workspace list exposes only the label, so the create-time rule (see the
  # --worktree block below, which passes exactly this to `--label`) is the only
  # key available.
  [ -n "$name" ] || name="$rm_slug"

  # Deliberately not silenced: dcx --rm names each container, volume and state
  # dir it removes, and a removal that quietly did nothing is exactly the
  # failure this path was reported for.
  dcx --rm "$instance" \
    || printf 'dcws: no dcx instance %s to remove\n' "$instance" >&2

  ws_id="$(herdr_workspace_id "$name")"
  if [ -n "$ws_id" ]; then
    rm_args=(--workspace "$ws_id")
    [ "$force" -eq 1 ] && rm_args+=(--force) || true
    herdr worktree remove "${rm_args[@]}"
    printf 'dcws: removed worktree %s (branch %s kept)\n' "$name" "$rm_branch"
  # A missing workspace is only benign when the checkout is gone too. With the
  # checkout still on disk this is the half-teardown above: exit non-zero
  # rather than report success over a worktree nobody removed.
  elif [ -n "$rm_checkout" ] && [ -d "$rm_checkout" ]; then
    printf 'dcws: no Herdr workspace labelled %s, but %s still exists\n' \
      "$name" "$rm_checkout" >&2
    printf 'dcws: pass -n LABEL (see `herdr workspace list`) or remove it with `git worktree remove`\n' >&2
    exit 1
  else
    printf 'dcws: no Herdr workspace labelled %s and no checkout for %s; nothing left to remove\n' \
      "$name" "$rm_branch"
  fi
  exit 0
fi

# --- worktree mode ------------------------------------------------------------
#
# `herdr worktree create` makes the checkout AND the workspace with its root
# pane, returning the same .result.workspace / .result.root_pane that plain
# `workspace create` returns. So this replaces that call rather than adding to
# it - creating both would leave an orphan workspace.
#
# It has to run before launch_args is built, because every pane must run
# `dcx -f <checkout>`, not `dcx -f <repo>`.
wt_created=""
if [ -n "$branch" ]; then
  need_herdr
  [ -n "$instance" ] || instance="$(dcws_slugify "$(basename "$folder")-$branch")"
  [ -n "$name" ] || name="$instance"

  wt=""
  # An existing workspace wins: the focus/relaunch path further down handles it,
  # and calling create again would fail on a checkout that is already there.
  if [ -z "$(herdr_workspace_id "$name")" ]; then
    create_args=(--cwd "$folder" --branch "$branch" --label "$name" --no-focus)
    [ -n "$base" ] && create_args+=(--base "$base") || true
    # Create when the branch has no checkout yet, open when it does. That split
    # is Herdr's own; create against an existing checkout is an error.
    wt_created="$(herdr worktree create "${create_args[@]}" 2>/dev/null)" \
      || wt_created="$(herdr worktree open --cwd "$folder" --branch "$branch" \
                         --label "$name" --no-focus)"
    # The field name for the checkout path is not in Herdr's published docs, so
    # this is a best effort; wt_path_for_branch below is the reliable answer.
    wt="$(printf '%s' "$wt_created" | jq -r '.result.worktree.path // empty')"
  fi
  [ -n "$wt" ] || wt="$(wt_path_for_branch "$folder" "$branch")"
  [ -n "$wt" ] || die "could not determine the checkout path for branch $branch"

  folder="$wt"
fi

# Build the dcx/dcclaude argument list once; both panes run the same scope.
launch_args=()
if [ -n "$profile" ]; then
  [ -n "$instance" ] || instance="$(basename "$folder")"
  launch_args+=(-p "$profile" --as "$instance" -f "$folder")
  launch_args+=(${passthru[@]+"${passthru[@]}"})
  [ -n "$name" ] || name="$instance"
else
  # Project mode keeps the original precondition: without a devcontainer config
  # there is nothing to attach to, and -p is how you say "make one".
  [ -f "$folder/.devcontainer/devcontainer.json" ] || [ -f "$folder/.devcontainer.json" ] \
    || die "no devcontainer config in $folder (use -p PROFILE for a sandbox)"
  launch_args+=(-f "$folder")
  [ -n "$name" ] || name="$(basename "$folder")"
fi

# Quote for `herdr pane run`, which takes a command line rather than an argv.
shell_cmd="dcx"
claude_cmd="dcclaude"
for a in ${launch_args[@]+"${launch_args[@]}"}; do
  shell_cmd="$shell_cmd $(printf '%q' "$a")"
  claude_cmd="$claude_cmd $(printf '%q' "$a")"
done

need_herdr

existing="$(herdr_workspace_id "$name")"

pane_by_label() { # <workspace> <label>
  herdr pane list --workspace "$1" | jq -r --arg l "$2" \
    'first(.result.panes[] | select(.label == $l) | .pane_id)'
}
pane_busy() { # <pane> - true if anything is running in the foreground
  local n
  n="$(herdr pane process-info --pane "$1" \
    | jq -r '.result.process_info.foreground_processes | length')"
  [ "${n:-0}" -gt 0 ]
}

if [ -n "$existing" ]; then
  if [ "$restart" -eq 1 ]; then
    relaunch() { # <pane> <command>
      [ -n "$1" ] || return 0
      if pane_busy "$1"; then
        printf 'dcws: %s still busy, left alone\n' "$1"
      else
        herdr pane run "$1" "$2" >/dev/null
        printf 'dcws: %s -> %s\n' "$1" "$2"
      fi
    }
    relaunch "$(pane_by_label "$existing" "shell:$name")" "$shell_cmd"
    if [ "$want_claude" -eq 1 ]; then
      relaunch "$(pane_by_label "$existing" "claude:$name")" "$claude_cmd"
    fi
  else
    printf 'dcws: workspace %s (%s) already exists - focusing (use -r to relaunch panes)\n' \
      "$name" "$existing"
  fi
  herdr workspace focus "$existing" >/dev/null
  exit 0
fi

# In worktree mode the workspace already exists - `herdr worktree create` made
# it along with the checkout. Creating a second one here would orphan the first.
if [ -n "$wt_created" ]; then
  created="$wt_created"
else
  created="$(herdr workspace create --cwd "$folder" --label "$name" --no-focus)"
fi
ws="$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id')"
root="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id')"

herdr pane rename "$root" "shell:$name" >/dev/null
herdr pane run "$root" "$shell_cmd" >/dev/null

if [ "$want_claude" -eq 1 ]; then
  right="$(herdr pane split "$root" --direction right --cwd "$folder" --no-focus \
    | jq -r '.result.pane.pane_id')"
  herdr pane rename "$right" "claude:$name" >/dev/null
  herdr pane run "$right" "$claude_cmd" >/dev/null
fi

herdr workspace focus "$ws" >/dev/null
printf 'dcws: workspace %s (%s) ready for %s\n' "$name" "$ws" "$folder"
