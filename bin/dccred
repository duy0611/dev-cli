#!/usr/bin/env bash
# dccred - credential lifecycle for dcx profile sandboxes.
#
# Deliberately separate from the launch path: minting is the part with real
# blast radius, so it should be runnable and testable on its own, and readable
# without wading through argument parsing for a shell wrapper.
#
# Nothing here runs inside a container. The container holds no credential
# capable of minting another, which is the point.
set -euo pipefail

DCX_PROG=dccred
LIB="$(cd -P "$(dirname "$( \
  src="${BASH_SOURCE[0]}"
  while [ -L "$src" ]; do
    d="$(cd -P "$(dirname "$src")" && pwd)"; src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$d/$src" ;; esac
  done
  printf '%s' "$src")")/../lib" && pwd)"
# shellcheck source=../lib/common.sh
. "$LIB/common.sh"
. "$LIB/instance.sh"
. "$LIB/pick.sh"
. "$LIB/mint.sh"
. "$LIB/env.sh"
. "$LIB/render.sh"

usage() {
  cat <<'EOF'
dccred - credential lifecycle for dcx profile sandboxes.

Usage:
  dccred mint    NAME      Mint all cloud credentials for the recorded scope
  dccred refresh NAME      Alias for mint - what the in-container shim tells you
  dccred env     NAME      Regenerate devcontainer.env (run by initializeCommand)
  dccred status [NAME]     Show instances and time remaining on each credential
  dccred pick    NAME      Re-run the scope pickers, then mint
  dccred watch             Poll every instance; notify via Herdr when one goes stale
  dccred -h                Show this help

Notes:
  A refresh lands without restarting the container: kubectl, gcloud and aws all
  read their credentials from files on every invocation, and those files are
  replaced atomically.
EOF
}

# --- helpers -----------------------------------------------------------------

require_instance() { # <name>
  [ -n "${1:-}" ] || die "an instance name is required"
  dcx_instance_exists "$1" || die "no such instance: $1 (see: dcx --list)"
}

# Prints "kind ttl_seconds" per configured credential, nothing for unconfigured.
cred_ttls() { # <name>
  local name="$1" creds kind exp now
  creds="$(dcx_creds_dir "$name")"
  now="$(date +%s)"
  for kind in k8s gcp aws; do
    [ -f "$creds/$kind.expiry" ] || continue
    exp="$(cat "$creds/$kind.expiry" 2>/dev/null || echo 0)"
    printf '%s %s\n' "$kind" "$(( exp - now ))"
  done
}

human() { # <seconds>
  local s=$1 sign=""
  [ "$s" -lt 0 ] && { s=$(( -s )); sign="-"; }
  if   [ "$s" -ge 3600 ]; then printf '%s%dh%02dm' "$sign" $(( s / 3600 )) $(( (s % 3600) / 60 ))
  elif [ "$s" -ge 60 ];   then printf '%s%dm' "$sign" $(( s / 60 ))
  else                         printf '%s%ds' "$sign" "$s"
  fi
}

# --- subcommands --------------------------------------------------------------

cmd_mint() {
  require_instance "${1:-}"
  need jq
  dcx_mint_all "$1"
}

cmd_env() {
  require_instance "${1:-}"
  need jq
  dcx_write_env_file "$1"
}

cmd_status() {
  need jq
  local names name line kind ttl
  if [ -n "${1:-}" ]; then require_instance "$1"; names="$1"; else names="$(dcx_list_instances)"; fi
  [ -n "$names" ] || { info "no instances"; return 0; }

  printf '%-20s %-6s %-8s %s\n' INSTANCE PROFILE STATE CREDENTIALS
  for name in $names; do
    local state=stopped
    [ -n "$(dcx_instance_container "$name")" ] && state=running || true
    line=""
    while read -r kind ttl; do
      [ -n "$kind" ] || continue
      if [ "$ttl" -le 0 ]; then line="$line $kind:EXPIRED"; else line="$line $kind:$(human "$ttl")"; fi
    done <<EOF
$(cred_ttls "$name")
EOF
    printf '%-20s %-6s %-8s %s\n' "$name" "$(dcx_meta "$name" '.profile')" "$state" "${line# }"
  done
}

cmd_pick() {
  require_instance "${1:-}"
  need jq
  local name="$1" profile patch
  profile="$(dcx_meta "$name" '.profile')"

  if dcx_profile_has_k8s "$profile"; then
    need kubectl
    ctx="$(dcx_pick_kube_context)" || die "no cluster selected"
    ns="$(dcx_pick_namespace "$ctx")" || die "no namespace selected"
    sa="$(dcx_pick_serviceaccount "$ctx" "$ns")" || die "no service account selected"
    patch="$(jq -n --arg c "$ctx" --arg n "$ns" --arg s "$sa" \
      '{k8s:{context:$c, namespace:$n, serviceaccount:$s}}')"
    dcx_instance_patch "$name" "$patch"
  fi
  if dcx_profile_has_gcp "$profile"; then
    need gcloud
    proj="$(dcx_pick_gcp_project)" || die "no GCP project selected"
    gsa="$(dcx_pick_gcp_sa "$proj")" || die "cancelled"
    dcx_instance_patch "$name" "$(jq -n --arg p "$proj" --arg s "$gsa" '{gcp:{project:$p, serviceaccount:$s}}')"
  fi
  if dcx_profile_has_aws "$profile"; then
    role="$(dcx_pick_aws_role)" || die "cancelled"
    dcx_instance_patch "$name" "$(jq -n --arg r "$role" '{aws:{role_arn:$r}}')"
  fi

  # The generated config embeds CLOUDSDK_CORE_PROJECT and AWS_REGION, so it has
  # to be re-rendered. That only takes effect on the next container create.
  dcx_render_devcontainer "$name"
  dcx_mint_all "$name"
  [ -n "$(dcx_instance_container "$name")" ] && \
    warn "$name is running: new scope applies to credentials now, but env changes need a recreate"
  return 0
}

# One process for every instance, not one per container. Fires on the
# transition to stale, so a long-expired credential does not re-notify every
# minute; state is in-memory and resets on restart, which is the right
# behaviour after a reboot.
cmd_watch() {
  need jq
  local interval="${DCX_WATCH_INTERVAL:-60}"
  local notified=" "   # space-delimited "name/kind" tokens
  info "watching credentials every ${interval}s"
  while :; do
    local name kind ttl token
    for name in $(dcx_list_instances); do
      while read -r kind ttl; do
        [ -n "$kind" ] || continue
        token="$name/$kind"
        if [ "$ttl" -le 0 ]; then
          case "$notified" in
            *" $token "*) ;;
            *)
              notified="$notified$token "
              if command -v herdr >/dev/null 2>&1; then
                herdr notification show "dcx: $kind token expired" \
                  --body "instance $name — run: dccred refresh $name" \
                  --sound request --position top-right >/dev/null 2>&1 || true
              fi
              info "$name: $kind expired"
              ;;
          esac
        else
          # Re-arm once refreshed, so the next expiry notifies again.
          notified="$(printf '%s' "$notified" | sed "s| $token | |")"
        fi
      done <<EOF
$(cred_ttls "$name")
EOF
    done
    sleep "$interval"
  done
}

# --- dispatch ----------------------------------------------------------------

case "${1:-}" in
  mint)          shift; cmd_mint "${1:-}" ;;
  refresh)       shift; cmd_mint "${1:-}" ;;
  env)           shift; cmd_env "${1:-}" ;;
  status)        shift; cmd_status "${1:-}" ;;
  pick)          shift; cmd_pick "${1:-}" ;;
  watch)         shift; cmd_watch ;;
  -h|--help|'')  usage ;;
  *)             usage >&2; die "unknown subcommand: $1" ;;
esac
